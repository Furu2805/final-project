{
  "$schema": "https://codesandbox.io/schemas/tasks.json",
  "setupTasks": [
    {
      "name": "Install backend dependencies",
      "command": "cd photo-sharing-backend && npm install"
    },
    {
      "name": "Install frontend dependencies",
      "command": "cd photo_sharing/photo-sharing-v1 && npm install"
    }
  ],
  "tasks": {
    "backend": {
      "name": "Start backend",
      "command": "cd photo-sharing-backend && npm start",
      "runAtStart": true,
      "preview": {
        "port": 8081
      }
    },
    "frontend": {
      "name": "Start frontend",
      "command": "cd photo_sharing/photo-sharing-v1 && npm start",
      "runAtStart": true,
      "preview": {
        "port": 3000
      }
    }
  }
}